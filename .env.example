# Environment variable reference only. The server does not read .env files.
# Configure these values in the MCP host (e.g. AgentDashboard).
TYPESAFE_API_KEY=
OPENAI_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_MODEL=gpt-6-luna
# Optional, if Chromium was installed outside Playwright's default cache:
# PLAYWRIGHT_BROWSERS_PATH=C:/path/to/JevUltrafastMCP/.browsers
